/* Main menu — port of "Main Menu v2" (claude.ai/design, Organic design system),
   repainted with the factory palette: dark iron, ember/brass and verdigris.
   Layout is authored at 1920x1080; PanelSettings scales it to fit the screen. */

:root {
    /* Hierro oscuro: paneles y tarjetas sobre la fábrica al anochecer */
    --color-bg: #221922;
    --color-surface: #2f222b;
    --color-surface-strong: #44313b;
    --color-badge: #3f2d37;
    --color-inset: #181118;
    --color-line: #5a4048;
    --color-text: #f4e6cd;
    --color-text-muted: #b9a48f;

    /* Ascua y latón: acción principal, marcos y detalles */
    --color-accent: #e58a2e;
    --color-accent-hover: #f5a24a;
    --color-accent-active: #c46f1c;
    --color-accent-soft: #5a3a1c;
    --color-on-accent: #2a1608;
    --color-on-accent-muted: #5c3511;
    --color-brass: #b8863b;

    /* Verdín: acento secundario (cobre oxidado, como las lentes del gato) */
    --color-verdigris: #5fa89a;
    --color-verdigris-light: #a9e0d2;
    --color-verdigris-soft: #223f3d;

    /* Papel: solo dentro del libro de niveles (ver .book) */
    --color-paper: #efe0c4;
    --color-paper-shade: #dcc9a6;
    --color-ink: #2b1f1b;
    --color-ink-muted: #6b5a4c;
    --color-verdigris-ink: #2f6158;
    --color-leather: #4a2a1e;

    -unity-font-definition: url("/Assets/Fonts/Figtree/Figtree-Regular SDF.asset");
    color: var(--color-text);
    font-size: 15px;
}

/* ---------- typography ---------- */

.font-display { -unity-font-definition: url("/Assets/Fonts/Rye/Rye-Regular SDF.asset"); -unity-font-style: normal; }
.font-semibold { -unity-font-definition: url("/Assets/Fonts/Figtree/Figtree-SemiBold SDF.asset"); }
.font-bold { -unity-font-definition: url("/Assets/Fonts/Figtree/Figtree-Bold SDF.asset"); }

.unity-label {
    padding: 0;
    margin: 0;
}

/* ---------- shared ---------- */

.mm-root {
    flex-grow: 1;
}

.mm-button {
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--color-text);
    -unity-text-align: middle-left;
    transition-property: background-color, scale;
    transition-duration: 0.12s;
}

.mm-button:disabled {
    opacity: 1;
}

.icon {
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.icon--hammer { background-image: url("Icons/hammer.png"); }
.icon--globe { background-image: url("Icons/globe.png"); }
.icon--exit { background-image: url("Icons/exit.png"); }
.icon--close { background-image: url("Icons/close.png"); }
.icon--chevron-left { background-image: url("Icons/chevron_left.png"); }
.icon--chevron-right { background-image: url("Icons/chevron_right.png"); }
.icon--lock { background-image: url("Icons/lock.png"); }
.icon--search { background-image: url("Icons/search.png"); }
.icon--play { background-image: url("Icons/play.png"); }

.pill-primary {
    flex-direction: row;
    align-items: center;
    background-color: var(--color-accent);
    color: var(--color-on-accent);
}

.pill-primary:hover { background-color: var(--color-accent-hover); }
.pill-primary:active { background-color: var(--color-accent-active); }

.pill-primary .icon--play {
    -unity-background-image-tint-color: var(--color-on-accent);
}

/* ---------- main panel ---------- */

.mm-panel {
    position: absolute;
    left: 96px;
    top: 80px;
    bottom: 80px;
    width: 720px;
    padding: 64px 48px 48px 48px;
    border-radius: 32px;
    border-width: 4px;
    border-color: var(--color-brass);
    background-color: rgba(34, 25, 34, 0.94);
}

.mm-title {
    flex-direction: row;
    align-items: center;
    margin: 0 0 40px 0;
}

.mm-title__icon {
    width: 176px;
    height: 176px;
    margin-right: 22px;
    flex-shrink: 0;
    background-image: url("Images/title_icon.png");
    -unity-background-scale-mode: scale-to-fit;
}

.mm-title Label {
    font-size: 68px;
    color: var(--color-text);
    -unity-text-align: upper-left;
}

.mm-title .mm-title__accent {
    color: var(--color-accent);
}

.mm-play {
    flex-direction: row;
    align-items: center;
    padding: 12px 40px 12px 12px;
    margin-bottom: 24px;
    background-color: var(--color-accent);
    color: var(--color-on-accent);
}

.mm-play:hover { background-color: var(--color-accent-hover); }
.mm-play:active { background-color: var(--color-accent-active); }

.mm-play__icon {
    width: 88px;
    height: 88px;
    margin-right: 22px;
    background-image: url("Images/play.png");
}

.mm-play:hover .mm-play__icon { background-image: url("Images/play_hover.png"); }

.mm-play__label {
    font-size: 40px;
    color: var(--color-on-accent);
    margin-bottom: 6px;
}

.mm-play__sub {
    font-size: 21px;
    color: var(--color-on-accent-muted);
}

.mm-item {
    flex-direction: row;
    align-items: center;
    padding: 8px 28px 8px 12px;
    margin-bottom: 6px;
}

.mm-item:hover { background-color: var(--color-surface); }
.mm-item:active { background-color: var(--color-surface-strong); }

.mm-item__badge {
    width: 60px;
    height: 60px;
    margin-right: 20px;
    border-radius: 30px;
    background-color: var(--color-badge);
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.mm-item__badge--online { background-color: var(--color-verdigris-soft); }

.mm-item__badge .icon { width: 30px; height: 30px; }
.mm-item__badge .icon--hammer { -unity-background-image-tint-color: var(--color-accent); }
.mm-item__badge .icon--globe { -unity-background-image-tint-color: var(--color-verdigris-light); }
.mm-item__badge .icon--exit { width: 28px; height: 28px; -unity-background-image-tint-color: var(--color-text-muted); }

.mm-item__img { width: 48px; height: 48px; }
.mm-item__img--door { background-image: url("Images/door.png"); }
.mm-item:hover .mm-item__img--door { background-image: url("Images/door_hover.png"); }
.mm-item__img--options { width: 50px; height: 50px; background-image: url("/Assets/Art/Sprites/UI/OptionsIcon_512.png"); }

.mm-item__label {
    font-size: 30px;
}

/* ---------- modal base ---------- */

.modal {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(12, 8, 14, 0.62);
    align-items: center;
    justify-content: center;
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.28s;
}

.modal--hidden {
    display: none;
}

.modal--entering {
    opacity: 0;
}

.modal-card {
    border-radius: 48px;
    border-width: 3px;
    border-color: var(--color-brass);
    background-color: var(--color-bg);
}

.pop {
    translate: 0 0;
    scale: 1 1;
    transition-property: translate, scale;
    transition-duration: 0.28s;
    transition-timing-function: ease-out;
}

.modal--entering .pop {
    translate: 0 16px;
    scale: 0.98 0.98;
}

.modal-title {
    font-size: 52px;
}

.round-button {
    position: absolute;
    align-items: center;
    justify-content: center;
    background-color: var(--color-bg);
}

.round-button .icon { -unity-background-image-tint-color: var(--color-text); }
.round-button:hover { background-color: var(--color-surface); }

/* ---------- select level ---------- */

.levels {
    background-color: rgba(12, 8, 14, 0.78);
    align-items: flex-start;
    justify-content: flex-start;
}

.levels__title {
    position: absolute;
    left: 200px;
    top: 34px;
    font-size: 52px;
    color: var(--color-text);
}

.levels__close {
    right: 56px;
    top: 36px;
    width: 64px;
    height: 64px;
}

.levels__close .icon { width: 28px; height: 28px; }

.levels__nav {
    top: 510px;
    width: 88px;
    height: 88px;
}

.levels__nav:hover { background-color: var(--color-accent-soft); }
.levels__nav:disabled { opacity: 0.4; }
.levels__nav:disabled:hover { background-color: var(--color-bg); }
.levels__nav .icon { width: 40px; height: 40px; }
.levels__nav--prev { left: 84px; }
.levels__nav--next { right: 84px; }

.book {
    position: absolute;
    left: 200px;
    top: 130px;
    width: 1520px;
    height: 860px;
    border-radius: 36px;
    background-color: var(--color-leather);

    /* Dentro del libro manda el papel: tinta oscura sobre pergamino. */
    --color-text: var(--color-ink);
    --color-text-muted: var(--color-ink-muted);
    --color-surface: var(--color-paper-shade);
    color: var(--color-ink);
}

.page {
    position: absolute;
    top: 18px;
    width: 742px;
    height: 824px;
    background-color: var(--color-paper);
}

.page--left {
    left: 18px;
    padding: 44px 56px;
    border-radius: 24px 6px 6px 24px;
    align-items: center;
    transform-origin: right;
}

.page--right {
    left: 760px;
    padding: 44px 56px 40px 56px;
    border-radius: 6px 24px 24px 6px;
    transform-origin: left;
}

/* The turning leaf: one page hinged at the spine. It folds flat over one side, then unfolds over the other. */
.leaf {
    scale: 1 1;
    transition-property: scale, background-color;
    transition-duration: 0.35s;
}

.leaf--fold { transition-timing-function: ease-in; }
.leaf--unfold { transition-timing-function: ease-out; }

.leaf--flat {
    scale: 0 1;
    background-color: var(--color-paper-shade);
}

.leaf__kicker {
    font-size: 20px;
    letter-spacing: 2.4px;
    color: var(--color-verdigris-ink);
    margin-bottom: 10px;
}

.leaf__title {
    font-size: 44px;
    color: var(--color-text);
}

.book__spine {
    position: absolute;
    left: 742px;
    top: 10px;
    width: 36px;
    height: 840px;
    border-radius: 18px;
    background-color: rgba(32, 30, 29, 0.1);
}

.book__ribbon {
    position: absolute;
    left: 1180px;
    bottom: -34px;
    width: 40px;
    height: 70px;
    border-radius: 0 0 8px 8px;
    background-color: var(--color-accent);
}

.chapter__num {
    font-size: 34px;
    color: var(--color-text-muted);
    margin-bottom: 24px;
}

.chapter__photo {
    width: 470px;
    height: 360px;
    padding: 16px;
    border-radius: 10px;
    background-color: #fbf3e4;
    rotate: -2deg;
    margin-bottom: 36px;
}

.chapter__art {
    flex-grow: 1;
    border-radius: 4px;
    background-color: var(--color-paper-shade);
    -unity-background-scale-mode: scale-and-crop;
    align-items: center;
    justify-content: center;
}

.chapter__art .icon--lock {
    width: 72px;
    height: 72px;
    -unity-background-image-tint-color: var(--color-ink-muted);
}

.chapter__kicker {
    font-size: 20px;
    letter-spacing: 2.4px;
    color: var(--color-verdigris-ink);
    margin-bottom: 6px;
    -unity-text-align: middle-center;
}

.chapter__name {
    font-size: 58px;
    color: var(--color-text);
    -unity-text-align: middle-center;
    margin-bottom: 32px;
}

.chapter__cogs {
    flex-direction: row;
}

.chapter__cog {
    width: 52px;
    height: 52px;
    margin: 0 8px;
    background-image: url("Images/gear.png");
}

.chapter__cog--pending {
    -unity-background-image-tint-color: rgba(150, 150, 150, 0.35);
}

.map__title {
    font-size: 40px;
    margin-bottom: 12px;
}

.map {
    flex-grow: 1;
}

.map--locked { opacity: 0.35; }

.map-node {
    position: absolute;
    width: 64px;
    height: 64px;
    align-items: center;
    justify-content: center;
}

.map-node:hover { scale: 1.12 1.12; }
.map-node:disabled:hover { scale: 1 1; }

.map-node__ring {
    position: absolute;
    left: 11px;
    top: 11px;
    width: 42px;
    height: 42px;
    border-radius: 9px;
    rotate: 45deg;
    background-color: #f0b878;
    display: none;
}

.map-node--picked .map-node__ring { display: flex; }

.map-node__diamond {
    width: 30px;
    height: 30px;
    rotate: 45deg;
    border-width: 4px;
    border-color: var(--color-ink);
    border-radius: 6px;
    background-color: var(--color-paper);
    transition-property: scale;
    transition-duration: 0.8s;
    transition-timing-function: ease-in-out;
}

.map-node--done .map-node__diamond { background-color: var(--color-verdigris); }
.map-node--current .map-node__diamond { background-color: var(--color-accent); }
.map-node--pulse .map-node__diamond { scale: 1.25 1.25; }

.map-node__code {
    position: absolute;
    left: -30px;
    top: -22px;
    font-size: 28px;
    color: var(--color-ink);
}

.map-marker {
    position: absolute;
    width: 60px;
    height: 60px;
    background-image: url("Images/gear.png");
    transition-property: left, top;
    transition-duration: 0.32s;
    transition-timing-function: ease-in-out;
}

.map-footer {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 16px 16px 16px 32px;
    background-color: var(--color-surface);
}

.map-footer__code {
    font-size: 32px;
    margin-bottom: 2px;
}

.map-footer__status {
    font-size: 20px;
    color: var(--color-text-muted);
}

.map-footer__play {
    padding: 18px 40px;
}

.map-footer__play .icon { width: 22px; height: 22px; margin-right: 12px; }
.map-footer__play Label { font-size: 28px; color: var(--color-on-accent); }

.map-locked {
    flex-direction: row;
    align-items: center;
    padding: 22px 32px;
    background-color: var(--color-surface);
}

.map-locked .icon {
    width: 26px;
    height: 26px;
    margin-right: 16px;
    -unity-background-image-tint-color: var(--color-ink);
}

.map-locked Label {
    font-size: 22px;
    color: var(--color-ink);
}

/* ---------- online levels ---------- */

.online {
    width: 1040px;
    height: 820px;
    padding: 48px 52px;
}

.online__close {
    right: 28px;
    top: 28px;
    width: 60px;
    height: 60px;
    background-color: var(--color-surface);
}

.online__close:hover { background-color: var(--color-surface-strong); }
.online__close .icon { width: 28px; height: 28px; }

.online .modal-title { margin-bottom: 28px; }

.search {
    flex-direction: row;
    align-items: center;
    height: 80px;
    padding: 0 28px;
    margin-bottom: 28px;
    border-width: 2px;
    border-color: var(--color-line);
    background-color: var(--color-inset);
}

.search > .icon {
    width: 30px;
    height: 30px;
    margin-right: 16px;
    -unity-background-image-tint-color: var(--color-text-muted);
}

.search__field {
    flex-grow: 1;
    margin: 0;
    padding: 0;
}

.search__field .unity-base-text-field__input {
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    padding: 0;
    font-size: 26px;
    color: var(--color-text);
    -unity-font-definition: url("/Assets/Fonts/Figtree/Figtree-Regular SDF.asset");
    --unity-cursor-color: var(--color-accent);
    --unity-selection-color: rgba(229, 138, 46, 0.35);
}

.search__field .unity-text-element--placeholder,
.search__field .unity-base-text-field__input--placeholder {
    color: var(--color-text-muted);
}

.online__list {
    flex-grow: 1;
}

/* Slim overlay-style scrollbar: no arrows, no track, rounded thumb. */
.online__list .unity-scroller--vertical {
    width: 10px;
    min-width: 10px;
    max-width: 10px;
    border-radius: 5px;
    overflow: hidden;
    margin-left: 12px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.online__list .unity-scroller__low-button,
.online__list .unity-scroller__high-button {
    display: none;
}

.online__list .unity-scroller--vertical > .unity-base-slider {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    margin: 0;
}

/* El tema por defecto da a las piezas internas un ancho mínimo mayor que la barra; se anula aquí. */
.online__list .unity-scroller--vertical .unity-base-slider__input,
.online__list .unity-scroller--vertical .unity-base-slider__drag-container {
    min-width: 0;
    width: 100%;
    margin: 0;
    padding: 0;
}

.online__list .unity-base-slider__tracker {
    left: 0;
    right: 0;
    margin: 0;
    border-width: 0;
    border-radius: 5px;
    background-color: rgba(244, 230, 205, 0.07);
}

.online__list .unity-base-slider__dragger {
    left: 0;
    width: 100%;
    margin: 0;
    border-width: 0;
    border-radius: 5px;
    background-color: var(--color-line);
}

.online__list .unity-base-slider__dragger:hover { background-color: var(--color-brass); }
.online__list .unity-base-slider__dragger-border { display: none; }

.online-row {
    flex-direction: row;
    align-items: center;
    padding: 14px 14px 14px 32px;
    margin-bottom: 10px;
    background-color: var(--color-surface);
    flex-shrink: 0;
}

.online-row__info {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-right: 22px;
}

.online-row__name {
    font-size: 26px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    margin-bottom: 2px;
}

.online-row__meta {
    font-size: 19px;
    color: var(--color-text-muted);
}

.online-row__code {
    padding: 8px 18px;
    margin-right: 22px;
    background-color: var(--color-verdigris-soft);
    color: var(--color-verdigris-light);
    font-size: 20px;
    letter-spacing: 1.6px;
}

.online-row__play {
    padding: 16px 30px;
}

.online-row__play .icon { width: 18px; height: 18px; margin-right: 10px; }
.online-row__play Label { font-size: 22px; color: var(--color-on-accent); }

.online__empty {
    padding: 48px 32px;
}

.online__empty-title {
    font-size: 32px;
    margin-bottom: 8px;
}

.online__empty-body {
    font-size: 22px;
    color: var(--color-text-muted);
    white-space: normal;
}

/* ---------- options ---------- */

.options {
    width: 960px;
    padding: 48px 52px 40px 52px;
}

.options .modal-title { margin-bottom: 24px; }

.options__close {
    right: 28px;
    top: 28px;
    width: 60px;
    height: 60px;
    background-color: var(--color-surface);
}

.options__close:hover { background-color: var(--color-surface-strong); }
.options__close .icon { width: 28px; height: 28px; }

/* Pestañas */
.tabs {
    flex-direction: row;
    margin-bottom: 20px;
}

.tab {
    height: 56px;
    padding: 0 36px;
    margin-right: 12px;
    font-size: 26px;
    color: var(--color-text-muted);
    background-color: var(--color-surface);
    -unity-text-align: middle-center;
}

.tab:hover { background-color: var(--color-surface-strong); }

.tab--active {
    color: var(--color-on-accent);
    background-color: var(--color-accent);
}

.tab--active:hover { background-color: var(--color-accent-hover); }

/* Página de cada pestaña: misma altura en todas para que la ventana no salte al cambiar. */
.options__page { height: 520px; }
.options__page--hidden { display: none; }

/* Fila de ajuste: título y descripción a la izquierda, control a la derecha. */
.setting {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding: 14px 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--color-line);
}

.setting__text {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 24px;
}

.setting__title { font-size: 26px; }

.setting__hint {
    margin-top: 2px;
    font-size: 18px;
    color: var(--color-text-muted);
    white-space: normal;
}

/* Selector de valor: flecha, valor actual, flecha. */
.stepper {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    width: 320px;
    height: 56px;
    border-width: 2px;
    border-color: var(--color-line);
    background-color: var(--color-inset);
}

.stepper__arrow {
    width: 56px;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.stepper__arrow .icon {
    width: 20px;
    height: 20px;
    -unity-background-image-tint-color: var(--color-text-muted);
}

.stepper__arrow:hover .icon { -unity-background-image-tint-color: var(--color-accent); }
.stepper__arrow:disabled .icon { opacity: 0.25; }

.stepper__value {
    flex-grow: 1;
    font-size: 22px;
    color: var(--color-text);
    -unity-text-align: middle-center;
}

/* Ajustes avanzados: botón que despliega el resto de filas. */
.advanced-toggle {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    height: 60px;
    margin-top: 20px;
    padding: 0 24px 0 28px;
    border-radius: 20px;
    background-color: var(--color-surface);
}

.advanced-toggle:hover { background-color: var(--color-surface-strong); }
.advanced-toggle__label { font-size: 24px; }

.advanced-toggle__arrow {
    width: 20px;
    height: 20px;
    rotate: 90deg;
    -unity-background-image-tint-color: var(--color-text-muted);
}

.advanced-toggle--open .advanced-toggle__arrow { rotate: -90deg; }

.advanced { margin-top: 6px; }
.advanced--hidden { display: none; }

/* Volumen */
.options .volume-slider {
    flex-shrink: 0;
    width: 320px;
    height: 40px;
    margin: 0;
}

.options .volume-slider .unity-base-slider__tracker {
    height: 10px;
    margin-top: -5px;
    border-width: 0;
    border-radius: 5px;
    background-color: var(--color-line);
}

.options .volume-slider .unity-base-slider__dragger {
    width: 28px;
    height: 28px;
    margin-top: -14px;
    border-width: 0;
    border-radius: 14px;
    background-color: var(--color-accent);
}

.options .volume-slider .unity-base-slider__dragger:hover { background-color: var(--color-accent-hover); }
.options .volume-slider .unity-base-slider__dragger-border { display: none; }

.volume-value {
    width: 84px;
    flex-shrink: 0;
    font-size: 22px;
    -unity-text-align: middle-right;
}

/* Misma barra de scroll fina que la lista de niveles online. */
.options__scroll .unity-scroller--vertical {
    width: 10px;
    min-width: 10px;
    max-width: 10px;
    border-radius: 5px;
    overflow: hidden;
    margin-left: 14px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.options__scroll .unity-scroller__low-button,
.options__scroll .unity-scroller__high-button {
    display: none;
}

.options__scroll .unity-scroller--vertical > .unity-base-slider {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    margin: 0;
}

/* El tema por defecto da a las piezas internas un ancho mínimo mayor que la barra; se anula aquí. */
.options__scroll .unity-scroller--vertical .unity-base-slider__input,
.options__scroll .unity-scroller--vertical .unity-base-slider__drag-container {
    min-width: 0;
    width: 100%;
    margin: 0;
    padding: 0;
}

.options__scroll .unity-scroller--vertical .unity-base-slider__tracker {
    left: 0;
    right: 0;
    margin: 0;
    border-width: 0;
    border-radius: 5px;
    background-color: rgba(244, 230, 205, 0.07);
}

.options__scroll .unity-scroller--vertical .unity-base-slider__dragger {
    left: 0;
    width: 100%;
    margin: 0;
    border-width: 0;
    border-radius: 5px;
    background-color: var(--color-line);
}

.options__scroll .unity-scroller--vertical .unity-base-slider__dragger:hover { background-color: var(--color-brass); }
.options__scroll .unity-scroller--vertical .unity-base-slider__dragger-border { display: none; }

/* ---------- exit ---------- */

.exit {
    width: 640px;
    padding: 48px;
}

.exit .modal-title {
    font-size: 44px;
    margin-bottom: 14px;
}

.exit__body {
    font-size: 24px;
    color: var(--color-text-muted);
    margin-bottom: 36px;
}

.exit__actions {
    flex-direction: row;
}

.exit__button {
    padding: 18px 36px;
    margin-right: 14px;
    font-size: 24px;
    -unity-text-align: middle-center;
}

.exit__button--stay { background-color: var(--color-surface); }
.exit__button--stay:hover { background-color: var(--color-surface-strong); }
.exit__button--leave { color: var(--color-on-accent); }
