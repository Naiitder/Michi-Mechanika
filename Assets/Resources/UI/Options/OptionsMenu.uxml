<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="/Assets/UI/MainMenu/MainMenu.uss" />
    <!-- Options window: tabs (Graphics, Volume). Shown by OptionsMenu.Open() from the main menu and
         the pause menu; the setting rows are built by OptionsMenu. Shares the main menu stylesheet. -->
    <ui:VisualElement name="root" class="mm-root" picking-mode="Ignore">
        <ui:VisualElement name="options-modal" class="modal">
            <ui:VisualElement name="options-card" class="modal-card options pop">
                <ui:Label text="Options" class="font-display modal-title" />
                <ui:VisualElement class="tabs">
                    <ui:Button name="tab-graphics" text="Graphics" class="mm-button font-display tab tab--active" />
                    <ui:Button name="tab-volume" text="Volume" class="mm-button font-display tab" />
                </ui:VisualElement>

                <ui:ScrollView name="page-graphics" class="options__page options__scroll" horizontal-scroller-visibility="Hidden">
                    <ui:VisualElement name="graphics-main" />
                    <ui:Button name="advanced-toggle" class="mm-button advanced-toggle">
                        <ui:Label text="Advanced settings" class="font-display advanced-toggle__label" picking-mode="Ignore" />
                        <ui:VisualElement class="icon icon--chevron-right advanced-toggle__arrow" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:VisualElement name="graphics-advanced" class="advanced advanced--hidden" />
                </ui:ScrollView>

                <ui:VisualElement name="page-volume" class="options__page options__page--hidden">
                    <ui:VisualElement class="setting">
                        <ui:VisualElement class="setting__text">
                            <ui:Label text="Master volume" class="font-display setting__title" />
                            <ui:Label text="Overall loudness of everything in the game." class="font-semibold setting__hint" />
                        </ui:VisualElement>
                        <ui:Slider name="volume-master" low-value="0" high-value="100" class="volume-slider" />
                        <ui:Label name="volume-master-value" text="100%" class="font-bold volume-value" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:Button name="options-close" class="mm-button round-button options__close">
                    <ui:VisualElement class="icon icon--close" picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
